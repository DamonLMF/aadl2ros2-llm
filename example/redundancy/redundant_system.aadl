PACKAGE redundant_system
PUBLIC
WITH Data_model;

-- This model describes a redundant acquisition system composed of three identical
-- sensors and a consistency detection switch.
-- The input of the sensors are made available from the outside for testing
-- purpose.
-- Two different implementation styles are provided for the Behavior Annex
-- detection.singlestate: one single BA state with nested if statements
-- detection.multistates: five BA staes without if statements
-- both give the same result.

data int
properties
  Data_Model::Data_Representation => Integer;
end int;

SYSTEM redundant_system
END redundant_system;

SYSTEM IMPLEMENTATION redundant_system.others
SUBCOMPONENTS
  HW : SYSTEM HW.others;
  SW : PROCESS SW.others;
PROPERTIES
  Actual_Processor_Binding => ( reference(HW.CPU) ) applies to SW;
  Actual_Memory_Binding => ( reference(HW.RAM) ) applies to SW;
END redundant_system.others;

SYSTEM HW
END HW;

SYSTEM IMPLEMENTATION HW.others
SUBCOMPONENTS
  CPU : PROCESSOR CPU;
  RAM : MEMORY RAM;
END HW.others;

PROCESSOR CPU
PROPERTIES
  Scheduling_Protocol => (HPF);
END CPU;

MEMORY RAM
END RAM;

PROCESS SW
FEATURES
  status : OUT DATA PORT int;
  data_out : OUT DATA PORT int;
  data_in : IN DATA PORT int;
END SW;

PROCESS IMPLEMENTATION SW.others
SUBCOMPONENTS
  sensor1 : THREAD sensor
    { Dispatch_Protocol => Periodic;
      Priority => 10;
      Deadline => 50ms;
      Period => 50ms; };
  sensor2 : THREAD sensor
    { Dispatch_Protocol => Periodic;
      Priority => 10;
      Deadline => 50ms;
      Period => 50ms; };
  sensor3 : THREAD sensor
    { Dispatch_Protocol => Periodic;
      Priority => 10;
      Deadline => 50ms;
      Period => 50ms; };
-- Select only one of the two following lines: 
--  detection : THREAD detection.singlestate;
  detection : THREAD detection.multistates;
  isolation : THREAD isolation;
CONNECTIONS
  cnx_0 : PORT data_in -> sensor1.data_in;
  cnx_1 : PORT data_in -> sensor2.data_in;
  cnx_2 : PORT data_in -> sensor3.data_in;
  cnx_3 : PORT detection.data_out -> data_out;
  cnx_4 : PORT detection.status -> status;
  cnx_5 : PORT sensor1.data_out -> detection.data1_in;
  cnx_6 : PORT sensor2.data_out -> detection.data2_in;
  cnx_7 : PORT sensor3.data_out -> detection.data3_in;
  cnx_8 : PORT detection.status -> isolation.status;
  cnx_9 : PORT isolation.sensor1 -> sensor1.enabled;
  cnx_10 : PORT isolation.sensor2 -> sensor2.enabled;
  cnx_11 : PORT isolation.sensor3 -> sensor3.enabled;
END SW.others;

THREAD sensor
FEATURES
  enabled : IN DATA PORT int;
  data_in : IN DATA PORT int;
  data_out : OUT DATA PORT int;
ANNEX Behavior_Specification {**
  VARIABLES
    e : int;
  STATES 
    s : INITIAL COMPLETE FINAL STATE;
  TRANSITIONS
    t : s -[ ON DISPATCH ]-> s {
    err!(1,e);
    IF ( enabled = 1 ) data_out := data_in + e END IF;
    IF ( enabled = 0 ) data_out := 0 END IF };
**};
END sensor;

THREAD detection
FEATURES
  data1_in : IN DATA PORT int;
  data2_in : IN DATA PORT int;
  data3_in : IN DATA PORT int;
  data_out : OUT DATA PORT int;
  status : OUT DATA PORT int;
PROPERTIES
  Dispatch_Protocol => Periodic;
  Priority => 5;
  Deadline => 50ms;
  Dispatch_Offset => 20ms;
  Period => 50ms;
END detection;

THREAD IMPLEMENTATION detection.multistates
ANNEX Behavior_Specification {**
VARIABLES
  d12, d23, d31 : int;
STATES
  -- State 0: Compute sensors value differences
  s0 : INITIAL COMPLETE FINAL STATE;
  -- State 1: Test difference between sensors 1 and 2
  s1 : STATE;
  -- State 2: Test difference between sensors 2 and 3 
  -- when sensors 1 and 2 give the same value
  s2 : STATE;
  -- State 3: Test difference between sensors 2 and 3 
  -- when sensors 1 and 2 give different values
  s3 : STATE;
  -- State 4: Test difference between sensors 3 and 1
  -- when sensors 2 and 3 give different values
  s4 : STATE;
TRANSITIONS
  -- State 0
  t0 : s0 -[  ]-> s1 {
    d12 := data1_in - data2_in;
    d23 := data2_in - data3_in;
    d31 := data3_in - data1_in };
  -- State 1
  t1 : s1 -[ d12 = 0 ]-> s2;
  t2 : s1 -[ d12 != 0 ]-> s3;
  -- State 2
    -- All sensors give the same value
  t3 : s2 -[ d23 = 0 ]-> s0 {
    data_out := data1_in;
    status := 0 };
    -- Or sensor 3 gives a wrong value
  t4 : s2 -[ d23 != 0 ]-> s0 {
    data_out := data1_in;
    status := 3 };
  -- State 3
    -- Sensor 1 gives a wrong value
  t5 : s3 -[ d23 = 0 ]-> s0 {
    data_out := data2_in;
    status := 1 };
    -- Or we must test the difference between 1 and 3
  t6 : s3 -[ d23 != 0 ]-> s4;
  -- State 4
    -- Sensor 2 gives a wrong value
  t7 : s4 -[ d31 = 0 ]-> s0 {
    data_out := data1_in;
    status := 2 };
    -- Or all sensors give different values
  t8 : s4 -[ d31 != 0 ]-> s0 {
    data_out := "error";
    status := -1 };
**};
END detection.multistates;

THREAD IMPLEMENTATION detection.singlestate
ANNEX Behavior_Specification {**
VARIABLES
  d12, d23, d31 : int;
STATES
  -- Single state
  s0 : INITIAL COMPLETE FINAL STATE;
TRANSITIONS
  -- compute sensors value differences
  t0 : s0 -[  ]-> s0 { 
    -- Compute sensors value differences
    d12 := data1_in - data2_in;
    d23 := data2_in - data3_in;
    d31 := data3_in - data1_in;
    if (d12 = 0) {
      if (d23 = 0) {
      -- All sensors give the same value
        data_out := data1_in;
        status := 0 } 
      else {
        -- Sensor 3 gives a wrong value
        data_out := data1_in;
        status := 3 } 
      end if } 
    else {
      if (d23 = 0) {
        -- Sensor 1 gives a wrong value
        data_out := data2_in;
        status := 1 } 
      else {
        if (d31 = 0) {
          -- Sensor 2 gives a wrong value
          data_out := data1_in; 
          status := 2 } 
        else {
          -- All sensors give different values
          data_out := "error";
          status := -1 } 
        end if }
      end if }
    end if };
 **};
END detection.singlestate;

THREAD isolation
FEATURES
  status : IN DATA PORT int;
  sensor1 : OUT DATA PORT int;
  sensor2 : OUT DATA PORT int;
  sensor3 : OUT DATA PORT int;
PROPERTIES
  Dispatch_Protocol => Periodic;
  Priority => 4;
  Deadline => 50ms;
  Period => 50ms;
ANNEX Behavior_Specification {**
  STATES 
    s : INITIAL COMPLETE FINAL STATE;
  TRANSITIONS
    t : s -[ ON DISPATCH ]-> s {
    sensor1 := 1;
    sensor2 := 1;
    sensor3 := 1 };
**};
END isolation;

END redundant_system;